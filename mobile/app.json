{
  "expo": {
    "name": "TenTen",
    "slug": "tentenloupe",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "tentenloupe",
    "ios": {
      "bundleIdentifier": "com.fairorth.tentenloupe",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "TenTen uses the camera to photograph and identify your watches.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fairorth.tentenloupe",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#f2f6f8"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TenTen can use Face ID to unlock the app."
        }
      ],
      "expo-router"
    ],
    "owner": "fairorth",
    "extra": {
      "eas": {
        "projectId": "4de84e46-0037-49ac-bc50-84f2407bcd46"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4de84e46-0037-49ac-bc50-84f2407bcd46",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
